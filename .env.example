# NordVPN SOCKS5 Proxy Configuration (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values. Never commit .env.
#
# Every page fetch is checked for anti-bot/captcha pages (DataDome) with or
# without a proxy. With NORDVPN_* set, a blocked fetch rotates to the next
# server and retries; without it (leave the three values empty), the page is
# reported as blocked (detail_status "blocked") and the next run retries it.
#
# How to get credentials:
#   nordvpn.com → My Account → NordVPN Service → Manual Setup → Credentials tab
#   (These are SERVICE credentials, separate from your nordvpn.com login.)
#
# How to pick SOCKS5 server hostnames:
#   nordvpn.com/servers/tools/ → filter SOCKS5 → pick country codes
#   Port is always 1080.
#
# Example country-level hostnames (confirmed via NordVPN API March 2026):
#   socks-nl1.nordvpn.com  Netherlands
#   socks-nl2.nordvpn.com  Netherlands (alt)
#   socks-us28.nordvpn.com United States
#   socks-se8.nordvpn.com  Sweden
# Find more: curl -s "https://api.nordvpn.com/v1/servers?filters[servers_technologies][identifier]=socks&limit=50"
#            | python3 -c "import json,sys; [print(s['hostname']) for s in json.load(sys.stdin)]"
# ─────────────────────────────────────────────────────────────────────────────

NORDVPN_USER=your_service_username_here
NORDVPN_PASS=your_service_password_here

# Comma-separated list of SOCKS5 server hostnames to rotate through
NORDVPN_SERVERS=socks-nl1.nordvpn.com,socks-us28.nordvpn.com,socks-se8.nordvpn.com

# How many requests before proactively switching to the next proxy (default: 15)
PROXY_ROTATE_EVERY=15

# ─────────────────────────────────────────────────────────────────────────────
# Scraper / browser (defaults shown; uncomment to override)
# ─────────────────────────────────────────────────────────────────────────────
# Parallel detail-page fetches and VPN rotation cadence for the CLI and MCP
# server. Scheduled runs use each search config's own values instead.
# DETAIL_CONCURRENCY=5
# VPN_ROTATE_EVERY_BATCHES=3
# Set to false to watch the Camoufox window while it scrapes.
# BROWSER_HEADLESS=true
# Set to 1 to skip image downloads (faster, but a client that never loads
# images can look more bot-like to DataDome, so it is off by default).
# BLOCK_ASSETS=0

# ─────────────────────────────────────────────────────────────────────────────
# LLM / Analysis
# ─────────────────────────────────────────────────────────────────────────────
# Anthropic is used when ANTHROPIC_API_KEY is set; otherwise OpenRouter.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
# Reasoning effort for scoring: low | medium | high (default: low). Ignored by
# Anthropic models without effort support (e.g. Haiku 4.5).
ANALYSIS_EFFORT=low
# Max parallel scoring calls (default: 5)
# ANALYSIS_CONCURRENCY=5

# ─────────────────────────────────────────────────────────────────────────────
# Notion (required if auto_notion_push enabled)
# ─────────────────────────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_APARTMENTS_DB_ID=
NOTION_AREAS_DB_ID=
NOTION_AGENCIES_DB_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Paths and services (defaults shown)
# ─────────────────────────────────────────────────────────────────────────────
# `apt start` sets DB_PATH, PREFERENCES_FILE and Streamlit's BACKEND_URL itself.
# When starting services by hand the backend reads this file at startup, but
# Vite only sees BACKEND_URL when it is exported in the shell.
# DB_PATH=data/app.db
# PREFERENCES_FILE=preferences.txt
# SQLite journal mode: WAL (default, crash-safe), or DELETE / TRUNCATE on
# filesystems where WAL's shared-memory file is unreliable (Docker bind mounts).
# SQLITE_JOURNAL_MODE=WAL
# Built React app FastAPI serves at / (default: src/web/dist)
# WEB_DIST_DIR=src/web/dist
# Backend URL for Streamlit and the Vite dev proxy
# BACKEND_URL=http://localhost:8000
